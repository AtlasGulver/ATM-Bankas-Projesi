# BANKA SİMÜLASYONU
hesap = 1000000

while True:
  print("""
               ATM'mize hoş geldiniz!!
  1)Para Çekme
  2)Para Yatırma
  3)Bakiye Bilgisi
  4)Çıkış
  """)

  secim = int(input("Lütfen seçiminizi giriniz:"))

  if secim == 1:
    cekim = int(input("Çekmek istediğiniz tutarı giriniz:"))
    if cekim > hesap:
      print("O kadar paran yok")
      continue
    else:
      hesap -= cekim
  elif secim == 2:
    yatir = int(input("Yatırmak istediğiniz tutarı giriniz:"))
    hesap += yatir
    continue

  elif secim == 3:
     print(f"Bakiyeniz: {hesap}₺")
     continue

  elif secim == 4:
    print("Çıkış yaptınız. Görüşmek üzereee (Ya da hiç :)")
    break
  else:
    print("1-4 arası bir rakam seç")
